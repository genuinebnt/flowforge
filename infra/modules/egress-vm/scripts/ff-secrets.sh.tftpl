#!/bin/bash
# Read the proxy's secrets from Secret Manager with the VM's service account
# (COS has curl but no gcloud) into /run/ff, a tmpfs, mode 0600.
set -euo pipefail
project='${project}'
md=http://metadata.google.internal/computeMetadata/v1
umask 077
mkdir -p /run/ff

token() {
  curl -sSf -H 'Metadata-Flavor: Google' "$md/instance/service-accounts/default/token" |
    sed -n 's/.*"access_token" *: *"\([^"]*\)".*/\1/p'
}
secret() { # $1 = secret id; prints the payload of its latest version
  curl -sSf -H "Authorization: Bearer $TOKEN" \
    "https://secretmanager.googleapis.com/v1/projects/$project/secrets/$1/versions/latest:access" |
    tr -d ' \n' | sed -n 's/.*"data":"\([^"]*\)".*/\1/p' | base64 -d
}

TOKEN=""
for _ in $(seq 1 30); do TOKEN="$(token || true)"; [ -n "$TOKEN" ] && break; sleep 5; done
[ -n "$TOKEN" ] || { echo "ff-secrets: no access token from the metadata server" >&2; exit 1; }

{
  :
%{ for name, id in secrets ~}
  printf '%s=%s\n' '${name}' "$(secret '${id}')"
%{ endfor ~}
} > /run/ff/egress-proxy.env
