{
  "id": "vec_002a",
  "description": "Exact L2 top-k on a tiny set; four points at distance 1 from the origin tie and are ordered by id; deletes hide immediately",
  "metric": "l2",
  "dim": 2,
  "tolerance": 0,
  "steps": [
    { "op": "upsert", "id": "00000000-0000-0000-0000-000000000006", "vector": [0, -1], "seq": 1 },
    { "op": "upsert", "id": "00000000-0000-0000-0000-000000000005", "vector": [2, 2], "seq": 2 },
    { "op": "upsert", "id": "00000000-0000-0000-0000-000000000004", "vector": [-1, 0], "seq": 3 },
    { "op": "upsert", "id": "00000000-0000-0000-0000-000000000003", "vector": [0, 1], "seq": 4 },
    { "op": "upsert", "id": "00000000-0000-0000-0000-000000000002", "vector": [1, 0], "seq": 5 },
    { "op": "upsert", "id": "00000000-0000-0000-0000-000000000001", "vector": [0, 0], "seq": 6 },
    { "op": "search", "vector": [0, 0], "k": 3, "expect": [
      { "id": "00000000-0000-0000-0000-000000000001", "distance": 0 },
      { "id": "00000000-0000-0000-0000-000000000002", "distance": 1 },
      { "id": "00000000-0000-0000-0000-000000000003", "distance": 1 } ] },
    { "op": "search", "vector": [0, 0], "k": 6, "expect": [
      { "id": "00000000-0000-0000-0000-000000000001", "distance": 0 },
      { "id": "00000000-0000-0000-0000-000000000002", "distance": 1 },
      { "id": "00000000-0000-0000-0000-000000000003", "distance": 1 },
      { "id": "00000000-0000-0000-0000-000000000004", "distance": 1 },
      { "id": "00000000-0000-0000-0000-000000000006", "distance": 1 },
      { "id": "00000000-0000-0000-0000-000000000005", "distance": 8 } ] },
    { "op": "search", "vector": [1, 1], "k": 2, "expect": [
      { "id": "00000000-0000-0000-0000-000000000002", "distance": 1 },
      { "id": "00000000-0000-0000-0000-000000000003", "distance": 1 } ] },
    { "op": "delete", "id": "00000000-0000-0000-0000-000000000002", "seq": 7 },
    { "op": "search", "vector": [0, 0], "k": 3, "expect": [
      { "id": "00000000-0000-0000-0000-000000000001", "distance": 0 },
      { "id": "00000000-0000-0000-0000-000000000003", "distance": 1 },
      { "id": "00000000-0000-0000-0000-000000000004", "distance": 1 } ] },
    { "op": "search", "vector": [0, 0], "k": 10, "expect": [
      { "id": "00000000-0000-0000-0000-000000000001", "distance": 0 },
      { "id": "00000000-0000-0000-0000-000000000003", "distance": 1 },
      { "id": "00000000-0000-0000-0000-000000000004", "distance": 1 },
      { "id": "00000000-0000-0000-0000-000000000006", "distance": 1 },
      { "id": "00000000-0000-0000-0000-000000000005", "distance": 8 } ] }
  ]
}
