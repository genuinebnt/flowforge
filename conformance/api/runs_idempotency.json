    {
      "name": "events",
      "request": {
        "method": "GET",
        "path": "/v1/runs/{{rid}}/events?page_size=1",
        "auth": "t1:viewer"
      },
      "expect": {
        "status": 200,
        "body": {
          "items": [
            {
              "seq": 1,
              "type": "run_submitted",
