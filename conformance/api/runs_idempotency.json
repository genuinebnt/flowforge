    },
    {
      "name": "idempotency on another POST (program create)",
      "request": {
        "method": "POST",
        "path": "/v1/programs",
        "auth": "t1:admin",
        "body": {
          "name": "Acme public bug bounty",
          "platform": "hackerone",
          "scope": {
            "rules": [
              {
                "id": "r1",
                "effect": "allow",
                "kind": "wildcard_domain",
                "value": "*.acme.com"
              },
              {
                "id": "r5",
                "effect": "deny",
                "kind": "domain",
                "value": "admin.corp.acme.com"
              }
            ],
            "activity": {
              "max_class": "active",
              "prohibited": [
                "dos"
              ],
              "rate": {
                "requests_per_second": 5,
                "burst": 10,
                "concurrency": 4
              },
              "windows": []
            }
          }
        },
        "headers": {
          "Idempotency-Key": "prog-1"
        }
      },
      "expect": {
        "status": 201,
        "body": {
          "id": "<id:prg>",
          "name": "<string>",
          "platform": "<string>",
          "status": "<string>",
          "current_version": "<int>",
          "created_at": "<timestamp>",
          "$exact": true
        }
      },
      "capture": {
        "p2": "id"
      }
    },
    {
      "name": "program create replay",
      "request": {
        "method": "POST",
        "path": "/v1/programs",
        "auth": "t1:admin",
        "body": {
          "name": "Acme public bug bounty",
          "platform": "hackerone",
          "scope": {
            "rules": [
              {
                "id": "r1",
                "effect": "allow",
                "kind": "wildcard_domain",
                "value": "*.acme.com"
              },
              {
                "id": "r5",
                "effect": "deny",
                "kind": "domain",
                "value": "admin.corp.acme.com"
              }
            ],
            "activity": {
              "max_class": "active",
              "prohibited": [
                "dos"
              ],
              "rate": {
                "requests_per_second": 5,
                "burst": 10,
                "concurrency": 4
              },
              "windows": []
