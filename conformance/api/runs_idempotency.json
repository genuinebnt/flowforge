          "scope_version": "<int>",
          "input": {
            "roots": [
              "acme.com"
            ]
          },
          "created_by": "<id:usr>",
          "created_at": "<timestamp>",
          "last_seq": "<int>",
          "output": null,
          "failure": null,
          "started_at": "<timestamp|null>",
          "finished_at": "<timestamp|null>",
          "waiting_on": null,
          "compensation_outcome": "<string|null>"
        }
      }
    },
    {
      "name": "other tenant: 404",
      "request": {
        "method": "GET",
        "path": "/v1/runs/{{rid}}",
        "auth": "t2:viewer"
      },
      "expect": {
        "status": 404,
        "body": {
          "error": {
            "code": "not_found",
            "status": 404,
            "message": "<string>",
            "details": "<array>",
            "request_id": "<id:req>"
          }
        }
      }
    },
    {
      "name": "list with filters",
      "request": {
        "method": "GET",
        "path": "/v1/runs?status=pending&program_id={{pid}}&created_after=2026-11-01T00:00:00Z",
        "auth": "t1:viewer"
      },
      "expect": {
        "status": 200,
        "body": {
          "items": [
            {
              "id": "{{rid}}"
            }
          ],
          "next_page_token": null
        }
      }
    },
    {
      "name": "bad status filter",
      "request": {
        "method": "GET",
        "path": "/v1/runs?status=sleeping",
        "auth": "t1:viewer"
      },
      "expect": {
        "status": 400,
        "body": {
          "error": {
            "code": "validation_failed",
            "status": 400,
            "message": "<string>",
            "details": "<array>",
            "request_id": "<id:req>"
          }
        }
      }
    },
    {
      "name": "bad created_after",
      "request": {
        "method": "GET",
        "path": "/v1/runs?created_after=yesterday",
        "auth": "t1:viewer"
      },
      "expect": {
        "status": 400,
        "body": {
          "error": {
            "code": "validation_failed",
            "status": 400,
            "message": "<string>",
            "details": "<array>",
            "request_id": "<id:req>"
          }
        }
      }
    },
    {
      "name": "cancel",
      "request": {
        "method": "POST",
        "path": "/v1/runs/{{rid}}:cancel",
        "auth": "t1:analyst",
        "body": {
          "reason": "test"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "id": "{{rid}}",
          "status": "cancelled",
          "workflow": "recon",
          "workflow_version": "<int>",
          "program_id": "{{pid}}",
          "scope_version": "<int>",
          "input": {
            "roots": [
              "acme.com"
            ]
          },
          "created_by": "<id:usr>",
          "created_at": "<timestamp>",
          "last_seq": "<int>",
          "output": null,
          "failure": null,
          "started_at": "<timestamp|null>",
          "finished_at": "<timestamp>",
          "waiting_on": null,
          "compensation_outcome": "<string|null>"
        }
      }
    },
    {
      "name": "cancel again",
      "request": {
        "method": "POST",
        "path": "/v1/runs/{{rid}}:cancel",
        "auth": "t1:analyst"
      },
      "expect": {
        "status": 409,
        "body": {
          "error": {
            "code": "run_not_cancellable",
            "status": 409,
            "message": "<string>",
            "details": "<array>",
            "request_id": "<id:req>"
          }
        }
      }
    },
    {
      "name": "viewer cannot cancel",
      "request": {
        "method": "POST",
        "path": "/v1/runs/{{rid}}:cancel",
        "auth": "t1:viewer"
      },
      "expect": {
        "status": 403,
        "body": {
          "error": {
            "code": "forbidden_role",
            "status": 403,
            "message": "<string>",
            "details": "<array>",
            "request_id": "<id:req>"
          }
        }
      }
    },
    {
      "name": "unknown verb",
      "request": {
        "method": "POST",
        "path": "/v1/runs/{{rid}}:explode",
