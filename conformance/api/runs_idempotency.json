      "capture": {
        "next": "next_page_token"
      }
    },
    {
      "name": "events page 2",
      "request": {
        "method": "GET",
        "path": "/v1/runs/{{rid}}/events?page_size=1&page_token={{next}}",
        "auth": "t1:viewer"
      },
      "expect": {
        "status": 200,
        "body": {
          "items": [
            {
              "seq": 2,
              "type": "run_cancelled"
