    {
      "name": "other tenant lists nothing",
      "request": {
        "method": "GET",
        "path": "/v1/programs",
        "auth": "t2:viewer"
      },
      "expect": {
        "status": 200,
        "body": {
          "items": [],
          "next_page_token": null
        }
      }
