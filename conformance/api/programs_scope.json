    {
      "name": "PATCH with stale If-Match",
      "request": {
        "method": "PATCH",
        "path": "/v1/programs/{{pid}}",
        "auth": "t1:admin",
        "body": {
          "status": "paused"
        },
        "headers": {
          "If-Match": "\"x\""
        }
      },
      "expect": {
        "status": 412,
        "body": {
          "error": {
            "code": "precondition_failed",
            "status": 412,
            "message": "<string>",
            "details": "<array>",
            "request_id": "<id:req>"
          }
        }
      }
    },
    {
      "name": "PATCH name is not supported (unknown field)",
      "request": {
        "method": "PATCH",
        "path": "/v1/programs/{{pid}}",
        "auth": "t1:admin",
        "body": {
          "name": "x"
        }
      },
      "expect": {
        "status": 400,
        "body": {
          "error": {
