          }
        }
      }
    },
    {
      "name": "PATCH pause",
      "request": {
        "method": "PATCH",
        "path": "/v1/programs/{{pid}}",
        "auth": "t1:admin",
        "body": {
          "status": "paused",
          "reason": "maintenance"
        },
        "headers": {
          "If-Match": "{{etag}}"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "id": "<id:prg>",
          "name": "<string>",
          "platform": "<string>",
          "status": "paused",
          "current_version": "<int>",
          "created_at": "<timestamp>",
          "$exact": true
        }
      }
    },
    {
      "name": "PATCH resume",
      "request": {
        "method": "PATCH",
        "path": "/v1/programs/{{pid}}",
        "auth": "t1:admin",
        "body": {
          "status": "active"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "id": "<id:prg>",
