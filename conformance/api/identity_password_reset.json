{
  "description": "Spec 12.3 password forgot/reset: uniform 202, single-use token, sessions revoked.",
  "steps": [
    {
      "name": "forgot (unknown)",
      "request": {
        "method": "POST",
        "path": "/v1/auth/password/forgot",
        "body": {
          "email": "nobody@example.com"
        }
      },
      "expect": {
        "status": 202,
        "body": {
          "message": "<string>",
          "$exact": true
        }
      }
    },
    {
      "name": "forgot (known)",
      "request": {
        "method": "POST",
        "path": "/v1/auth/password/forgot",
        "body": {
          "email": "{{t1_viewer_email}}"
        }
      },
      "expect": {
        "status": 202,
        "body": {
          "message": "<string>",
          "$exact": true
        }
      },
      "capture": {
        "tok": "email:password_reset:{{t1_viewer_email}}"
      }
    },
    {
      "name": "reset with a weak password",
      "request": {
        "method": "POST",
        "path": "/v1/auth/password/reset",
        "body": {
          "token": "{{tok}}",
          "password": "short"
        }
      },
      "expect": {
        "status": 400,
        "body": {
          "error": {
            "code": "validation_failed",
            "status": 400,
            "message": "<string>",
            "details": "<array>",
            "request_id": "<id:req>"
          }
        }
      }
    },
    {
      "name": "reset",
      "request": {
        "method": "POST",
        "path": "/v1/auth/password/reset",
        "body": {
          "token": "{{tok}}",
          "password": "a brand new password"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "message": "<string>"
        }
      }
    },
    {
      "name": "reset token is single use",
      "request": {
        "method": "POST",
        "path": "/v1/auth/password/reset",
        "body": {
          "token": "{{tok}}",
          "password": "another new password"
        }
      },
      "expect": {
        "status": 400,
        "body": {
          "error": {
            "code": "validation_failed",
            "status": 400,
            "message": "<string>",
            "details": "<array>",
            "request_id": "<id:req>"
          }
        }
      }
    },
    {
      "name": "old access token revoked",
      "request": {
        "method": "GET",
        "path": "/v1/me",
        "auth": "t1:viewer"
      },
      "expect": {
        "status": 401,
        "body": {
          "error": {
            "code": "token_invalid",
            "status": 401,
            "message": "<string>",
            "details": "<array>",
            "request_id": "<id:req>"
          }
        }
      }
    },
    {
      "name": "old password fails",
      "request": {
        "method": "POST",
        "path": "/v1/auth/login",
        "body": {
          "email": "{{t1_viewer_email}}",
          "password": "{{password}}"
        }
      },
      "expect": {
        "status": 401,
        "body": {
          "error": {
            "code": "token_invalid",
            "status": 401,
            "message": "<string>",
            "details": "<array>",
            "request_id": "<id:req>"
          }
        }
      }
    },
    {
      "name": "new password works",
      "request": {
        "method": "POST",
        "path": "/v1/auth/login",
        "body": {
          "email": "{{t1_viewer_email}}",
          "password": "a brand new password"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "access_token": "<nonempty>",
          "token_type": "Bearer",
          "expires_in": 600,
          "refresh_token": "<nonempty>",
          "user": {
            "id": "<id:usr>",
            "email": "<string>"
          },
          "tenant": {
            "id": "<id:ten>",
            "role": "<string>"
          }
        }
      }
    },
    {
      "name": "bad token format",
      "request": {
        "method": "POST",
        "path": "/v1/auth/password/reset",
        "body": {
          "token": "x",
          "password": "a brand new password"
        }
      },
      "expect": {
        "status": 400,
        "body": {
          "error": {
            "code": "validation_failed",
            "status": 400,
            "message": "<string>",
            "details": "<array>",
            "request_id": "<id:req>"
          }
        }
      }
    }
  ]
}
