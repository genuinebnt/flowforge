{
  "description": "Canonical keys of the network-infrastructure assets (spec 5.4, normalization per 4.2). Every spelling in a case must yield the same key; error cases must be rejected with ErrInvalidAsset.",
  "cases": [
    {"name": "fqdn case, whitespace and trailing dot",
     "spellings": [{"type": "FQDN", "name": "api.acme.com"}, {"type": "FQDN", "name": "API.Acme.COM."}, {"type": "FQDN", "name": "  api.acme.com  "}],
     "key": "fqdn:api.acme.com"},
    {"name": "fqdn unicode to punycode",
     "spellings": [{"type": "FQDN", "name": "Bücher.example"}, {"type": "FQDN", "name": "xn--bcher-kva.example"}],
     "key": "fqdn:xn--bcher-kva.example"},
    {"name": "fqdn underscore label kept",
     "spellings": [{"type": "FQDN", "name": "_dmarc.acme.com"}],
     "key": "fqdn:_dmarc.acme.com"},
    {"name": "fqdn empty label rejected", "spellings": [{"type": "FQDN", "name": "api..acme.com"}], "error": true},
    {"name": "fqdn numeric name rejected", "spellings": [{"type": "FQDN", "name": "2130706433"}], "error": true},
    {"name": "fqdn missing name rejected", "spellings": [{"type": "FQDN"}], "error": true},
    {"name": "ipv4 with and without ip_version",
     "spellings": [{"type": "IPAddress", "address": "203.0.113.10"}, {"type": "IPAddress", "address": "203.0.113.10", "ip_version": "IPv4"}, {"type": "IPAddress", "address": "::ffff:203.0.113.10"}],
     "key": "ip:203.0.113.10"},
    {"name": "ipv6 canonical text",
     "spellings": [{"type": "IPAddress", "address": "2001:DB8:0:0:0:0:0:1", "ip_version": "IPv6"}, {"type": "IPAddress", "address": "2001:db8::1"}],
     "key": "ip:2001:db8::1"},
    {"name": "ip leading zeros rejected", "spellings": [{"type": "IPAddress", "address": "203.000.113.010"}], "error": true},
    {"name": "ip zone rejected", "spellings": [{"type": "IPAddress", "address": "fe80::1%eth0"}], "error": true},
    {"name": "ip_version contradicting the address rejected", "spellings": [{"type": "IPAddress", "address": "203.0.113.10", "ip_version": "IPv6"}], "error": true},
    {"name": "netblock host bits zeroed",
     "spellings": [{"type": "Netblock", "cidr": "203.0.113.0/24"}, {"type": "Netblock", "cidr": "203.0.113.77/24", "ip_version": "IPv4"}],
     "key": "net:203.0.113.0/24"},
    {"name": "netblock ipv6",
     "spellings": [{"type": "Netblock", "cidr": "2001:DB8:1::5/48"}],
     "key": "net:2001:db8:1::/48"},
    {"name": "netblock without prefix length rejected", "spellings": [{"type": "Netblock", "cidr": "203.0.113.0"}], "error": true},
    {"name": "asn",
     "spellings": [{"type": "AutonomousSystem", "number": 64496}],
     "key": "asn:64496"},
    {"name": "asn 32-bit maximum", "spellings": [{"type": "AutonomousSystem", "number": 4294967295}], "key": "asn:4294967295"},
    {"name": "asn zero rejected", "spellings": [{"type": "AutonomousSystem", "number": 0}], "error": true},
    {"name": "asn above 32 bits rejected", "spellings": [{"type": "AutonomousSystem", "number": 4294967296}], "error": true}
  ]
}
