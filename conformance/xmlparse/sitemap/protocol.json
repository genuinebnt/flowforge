     "entries": [{"loc": "https://a.example/1", "lastmod": "", "changefreq": "", "priority": null}, {"loc": "https://a.example/2", "lastmod": "", "changefreq": "", "priority": null}, {"loc": "https://a.example/3", "lastmod": "", "changefreq": "", "priority": null}]}
  ]
