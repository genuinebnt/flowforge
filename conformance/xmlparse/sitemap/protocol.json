{
  "description": "sitemaps.org protocol 0.9: the protocol's examples and edge cases. lastmod is RFC 3339 UTC with milliseconds; priority null means absent.",
  "cases": [
    {"name": "protocol sample urlset", "input": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<urlset xmlns=\"http://www.sitemaps.org/schemas/sitemap/0.9\">\n   <url>\n      <loc>http://www.example.com/</loc>\n      <lastmod>2005-01-01</lastmod>\n      <changefreq>monthly</changefreq>\n      <priority>0.8</priority>\n   </url>\n</urlset>",
     "kind": "urlset", "grade": "complete", "diags": [],
     "entries": [{"loc": "http://www.example.com/", "lastmod": "2005-01-01T00:00:00.000Z", "changefreq": "monthly", "priority": 0.8}]},
    {"name": "protocol entity escaping example", "input": "<urlset xmlns=\"http://www.sitemaps.org/schemas/sitemap/0.9\"><url><loc>http://www.example.com/view.php?id=1&amp;mode=2</loc></url><url><loc>http://www.example.com/catalog?item=12&amp;desc=vacation_hawaii</loc><changefreq>weekly</changefreq></url></urlset>",
     "kind": "urlset", "grade": "complete",
     "entries": [{"loc": "http://www.example.com/view.php?id=1&mode=2", "lastmod": "", "changefreq": "", "priority": null},
                 {"loc": "http://www.example.com/catalog?item=12&desc=vacation_hawaii", "lastmod": "", "changefreq": "weekly", "priority": null}]},
    {"name": "protocol sample sitemap index", "input": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<sitemapindex xmlns=\"http://www.sitemaps.org/schemas/sitemap/0.9\">\n   <sitemap>\n      <loc>http://www.example.com/sitemap1.xml.gz</loc>\n      <lastmod>2004-10-01T18:23:17+00:00</lastmod>\n   </sitemap>\n   <sitemap>\n      <loc>http://www.example.com/sitemap2.xml.gz</loc>\n      <lastmod>2005-01-01</lastmod>\n   </sitemap>\n</sitemapindex>",
     "kind": "sitemapindex", "grade": "complete", "diags": [],
     "entries": [{"loc": "http://www.example.com/sitemap1.xml.gz", "lastmod": "2004-10-01T18:23:17.000Z", "changefreq": "", "priority": null},
                 {"loc": "http://www.example.com/sitemap2.xml.gz", "lastmod": "2005-01-01T00:00:00.000Z", "changefreq": "", "priority": null}]},
    {"name": "W3C datetime forms", "input": "<urlset xmlns=\"http://www.sitemaps.org/schemas/sitemap/0.9\"><url><loc>https://a.example/1</loc><lastmod>1997</lastmod></url><url><loc>https://a.example/2</loc><lastmod>1997-07</lastmod></url><url><loc>https://a.example/3</loc><lastmod>1997-07-16T19:20+01:00</lastmod></url><url><loc>https://a.example/4</loc><lastmod>1997-07-16T19:20:30.45Z</lastmod></url><url><loc>https://a.example/5</loc><lastmod>16/07/1997</lastmod></url></urlset>",
     "kind": "urlset", "grade": "complete", "diags": ["invalid_lastmod"],
     "entries": [{"loc": "https://a.example/1", "lastmod": "1997-01-01T00:00:00.000Z", "changefreq": "", "priority": null},
                 {"loc": "https://a.example/2", "lastmod": "1997-07-01T00:00:00.000Z", "changefreq": "", "priority": null},
                 {"loc": "https://a.example/3", "lastmod": "1997-07-16T18:20:00.000Z", "changefreq": "", "priority": null},
                 {"loc": "https://a.example/4", "lastmod": "1997-07-16T19:20:30.450Z", "changefreq": "", "priority": null},
                 {"loc": "https://a.example/5", "lastmod": "", "changefreq": "", "priority": null}]},
    {"name": "field validation", "input": "<urlset xmlns=\"http://www.sitemaps.org/schemas/sitemap/0.9\"><url><loc> https://a.example/x </loc><changefreq>Sometimes</changefreq><priority>1.5</priority></url><url><loc>https://a.example/y</loc><priority>0</priority><changefreq>NEVER</changefreq></url></urlset>",
     "kind": "urlset", "grade": "complete", "diags": ["invalid_changefreq", "invalid_priority"],
     "entries": [{"loc": "https://a.example/x", "lastmod": "", "changefreq": "", "priority": null},
                 {"loc": "https://a.example/y", "lastmod": "", "changefreq": "never", "priority": 0}]},
    {"name": "bad and missing loc drop the entry", "input": "<urlset xmlns=\"http://www.sitemaps.org/schemas/sitemap/0.9\"><url><loc>/relative</loc></url><url><loc>ftp://a.example/</loc></url><url><priority>0.5</priority></url><url><loc>https://ok.example/</loc></url></urlset>",
     "kind": "urlset", "grade": "complete", "diags": ["invalid_loc", "invalid_loc", "missing_loc"],
     "entries": [{"loc": "https://ok.example/", "lastmod": "", "changefreq": "", "priority": null}]},
    {"name": "duplicate field keeps the first", "input": "<urlset xmlns=\"http://www.sitemaps.org/schemas/sitemap/0.9\"><url><loc>https://a.example/1</loc><loc>https://a.example/2</loc></url></urlset>",
     "kind": "urlset", "diags": ["duplicate_field"], "entries": [{"loc": "https://a.example/1", "lastmod": "", "changefreq": "", "priority": null}]},
    {"name": "extensions are skipped", "input": "<urlset xmlns=\"http://www.sitemaps.org/schemas/sitemap/0.9\" xmlns:image=\"http://www.google.com/schemas/sitemap-image/1.1\" xmlns:xhtml=\"http://www.w3.org/1999/xhtml\"><url><loc>https://a.example/</loc><image:image><image:loc>https://a.example/i.png</image:loc></image:image><xhtml:link rel=\"alternate\" hreflang=\"de\" href=\"https://a.example/de\"/></url><foo><url><loc>https://hidden.example/</loc></url></foo></urlset>",
     "kind": "urlset", "grade": "complete", "diags": [], "entries": [{"loc": "https://a.example/", "lastmod": "", "changefreq": "", "priority": null}]},
    {"name": "CDATA loc", "input": "<urlset xmlns=\"http://www.sitemaps.org/schemas/sitemap/0.9\"><url><loc><![CDATA[https://a.example/?a=1&b=2]]></loc></url></urlset>",
     "kind": "urlset", "entries": [{"loc": "https://a.example/?a=1&b=2", "lastmod": "", "changefreq": "", "priority": null}]},
    {"name": "missing namespace accepted by default", "input": "<urlset><url><loc>https://a.example/</loc></url></urlset>",
     "kind": "urlset", "grade": "complete", "diags": ["missing_namespace"], "entries": [{"loc": "https://a.example/", "lastmod": "", "changefreq": "", "priority": null}]},
    {"name": "missing namespace refused when required", "input": "<urlset><url><loc>https://a.example/</loc></url></urlset>", "options": {"require_namespace": true},
     "kind": "unknown", "grade": "unsupported", "diags": ["not_sitemap"], "entries": []},
    {"name": "not a sitemap", "input": "<rss version=\"2.0\"><channel/></rss>", "kind": "unknown", "grade": "unsupported", "diags": ["not_sitemap"], "entries": []},
    {"name": "malformed XML keeps entries read so far", "input": "<urlset xmlns=\"http://www.sitemaps.org/schemas/sitemap/0.9\"><url><loc>https://a.example/</loc></url><url><loc>x</url></urlset>",
     "kind": "urlset", "grade": "failed", "diags": ["xml_error"], "entries": [{"loc": "https://a.example/", "lastmod": "", "changefreq": "", "priority": null}]},
    {"name": "XXE refused", "input": "<!DOCTYPE urlset [<!ENTITY x SYSTEM \"file:///etc/passwd\">]><urlset xmlns=\"http://www.sitemaps.org/schemas/sitemap/0.9\"><url><loc>&x;</loc></url></urlset>",
     "kind": "unknown", "grade": "unsupported", "diags": ["xml_error"], "entries": []},
    {"name": "gzip compressed", "gzip": true, "input": "<urlset xmlns=\"http://www.sitemaps.org/schemas/sitemap/0.9\"><url><loc>https://gz.example/</loc></url></urlset>",
     "kind": "urlset", "grade": "complete", "compressed": true, "entries": [{"loc": "https://gz.example/", "lastmod": "", "changefreq": "", "priority": null}]},
    {"name": "corrupt gzip", "input_hex": "1f8b0800000000000003ffffffff", "kind": "unknown", "grade": "failed", "compressed": true, "diags": ["gzip_invalid"], "entries": []},
