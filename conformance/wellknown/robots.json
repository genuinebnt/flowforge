{
  "description": "RFC 9309 robots.txt: the RFC's examples (§5.1, §5.2, §2.2.2 percent-encoding table) and edge cases. checks give an agent (product token or full UA string), a path with optional query, and the decision.",
  "cases": [
    {"name": "RFC 9309 5.1 simple example",
     "robots": "User-Agent: *\nDisallow: *.gif$\nDisallow: /example/\nAllow: /publications/\n\nUser-Agent: foobot\nDisallow:/\nAllow:/example/page.html\nAllow:/example/allowed.gif\n\nUser-Agent: barbot\nUser-Agent: bazbot\nDisallow: /example/page.html\n\nUser-Agent: quxbot\n",
     "groups": 4, "grade": "complete", "diags": [],
     "checks": [
      {"agent": "foobot", "path": "/", "allowed": false},
      {"agent": "foobot", "path": "/example/page.html", "allowed": true},
      {"agent": "foobot", "path": "/example/allowed.gif", "allowed": true},
      {"agent": "foobot", "path": "/example/other.gif", "allowed": false},
      {"agent": "barbot", "path": "/example/page.html", "allowed": false},
      {"agent": "bazbot", "path": "/example/page.html", "allowed": false},
      {"agent": "barbot", "path": "/example/page.htm", "allowed": true},
      {"agent": "quxbot", "path": "/example/page.html", "allowed": true},
      {"agent": "otherbot", "path": "/image.gif", "allowed": false},
      {"agent": "otherbot", "path": "/image.gif?x", "allowed": true},
      {"agent": "otherbot", "path": "/example/", "allowed": false},
      {"agent": "otherbot", "path": "/publications/x", "allowed": true},
      {"agent": "otherbot", "path": "/robots.txt", "allowed": true},
      {"agent": "FooBot/1.2 (+https://foo.example/bot)", "path": "/", "allowed": false}
     ]},
    {"name": "RFC 9309 5.2 longest match",
     "robots": "User-Agent: foobot\nAllow: /example/page/\nDisallow: /example/page/disallowed.gif\n",
     "checks": [
      {"agent": "foobot", "path": "/example/page/", "allowed": true},
      {"agent": "foobot", "path": "/example/page/disallowed.gif", "allowed": false},
      {"agent": "foobot", "path": "/example/page/other.gif", "allowed": true}
     ]},
    {"name": "allow wins a tie", "robots": "user-agent: a\nallow: /p\ndisallow: /p\n", "checks": [{"agent": "a", "path": "/page", "allowed": true}]},
    {"name": "wildcard counts toward length", "robots": "User-agent: a\nDisallow: /*.php\nAllow: /x.php\n",
     "checks": [{"agent": "a", "path": "/x.php", "allowed": false}, {"agent": "a", "path": "/y/x.php", "allowed": false}, {"agent": "a", "path": "/x.html", "allowed": true}]},
    {"name": "dollar anchors only at the end", "robots": "User-agent: *\nDisallow: /a$\nDisallow: /b$c\n",
     "checks": [{"agent": "x", "path": "/a", "allowed": false}, {"agent": "x", "path": "/ab", "allowed": true}, {"agent": "x", "path": "/b$c/d", "allowed": false}, {"agent": "x", "path": "/bc", "allowed": true}]},
    {"name": "percent-encoding table of 2.2.2",
     "robots": "User-agent: *\nDisallow: /foo/bar?baz=quz\nDisallow: /foo/bar/ツ\nDisallow: /q/%E3%83%84\nDisallow: /foo/bar/%62%61%7A\n",
     "checks": [
      {"agent": "x", "path": "/foo/bar?baz=quz", "allowed": false},
      {"agent": "x", "path": "/foo/bar/%E3%83%84", "allowed": false},
      {"agent": "x", "path": "/foo/bar/%e3%83%84", "allowed": false},
      {"agent": "x", "path": "/q/ツ", "allowed": false},
      {"agent": "x", "path": "/foo/bar/baz", "allowed": false},
      {"agent": "x", "path": "/foo/bar/%62az", "allowed": false},
      {"agent": "x", "path": "/foo/barbaz", "allowed": true}
     ]},
    {"name": "reserved percent-encodings are not decoded", "robots": "User-agent: *\nDisallow: /a%2Fb\n",
     "checks": [{"agent": "x", "path": "/a%2fb", "allowed": false}, {"agent": "x", "path": "/a/b", "allowed": true}]},
    {"name": "groups for the same agent are combined", "robots": "User-agent: a\nDisallow: /x\n\nUser-agent: b\nDisallow: /y\n\nUser-agent: A\nDisallow: /z\n",
     "checks": [{"agent": "a", "path": "/x", "allowed": false}, {"agent": "a", "path": "/z", "allowed": false}, {"agent": "a", "path": "/y", "allowed": true}]},
    {"name": "named group replaces the catch-all", "robots": "User-agent: *\nDisallow: /\n\nUser-agent: good\nDisallow: /private\n",
     "checks": [{"agent": "good", "path": "/public", "allowed": true}, {"agent": "bad", "path": "/public", "allowed": false}]},
    {"name": "no matching group allows everything", "robots": "User-agent: other\nDisallow: /\n", "checks": [{"agent": "mybot", "path": "/", "allowed": true}]},
    {"name": "empty disallow ends the agent run", "robots": "User-agent: a\nDisallow:\nUser-agent: b\nDisallow: /\n", "groups": 2,
     "checks": [{"agent": "a", "path": "/x", "allowed": true}, {"agent": "b", "path": "/x", "allowed": false}]},
    {"name": "blank lines and comments do not split a group", "robots": "User-agent: a # first\n\n# note\nUser-agent: b\n\nDisallow: /d\n", "groups": 1,
     "checks": [{"agent": "a", "path": "/d", "allowed": false}, {"agent": "b", "path": "/d", "allowed": false}]},
    {"name": "rules before any user-agent are ignored", "robots": "Disallow: /\nUser-agent: *\nAllow: /\n", "diags": ["rule_outside_group"],
     "checks": [{"agent": "x", "path": "/a", "allowed": true}]},
    {"name": "sitemaps are global", "robots": "Sitemap: https://example.com/sitemap.xml\nUser-agent: *\nDisallow: /a\nSitemap: https://example.com/s2.xml.gz\n",
     "sitemaps": ["https://example.com/sitemap.xml", "https://example.com/s2.xml.gz"], "checks": [{"agent": "x", "path": "/a", "allowed": false}]},
    {"name": "crawl-delay extension", "robots": "User-agent: slow\nCrawl-delay: 2.5\nDisallow: /x\n", "crawl_delay": {"agent": "slow", "millis": 2500},
     "checks": [{"agent": "slow", "path": "/x", "allowed": false}]},
    {"name": "invalid lines are skipped", "robots": "User-agent *\nUser-agent: a\nDisalow: /x\nCrawl-delay: soon\nDisallow: /y\n", "diags": ["invalid_line", "unknown_key", "invalid_crawl_delay"],
     "checks": [{"agent": "a", "path": "/x", "allowed": true}, {"agent": "a", "path": "/y", "allowed": false}]},
    {"name": "CRLF, CR and BOM", "robots": "﻿User-agent: a\r\nDisallow: /x\rDisallow: /y\r\n", "checks": [{"agent": "a", "path": "/x", "allowed": false}, {"agent": "a", "path": "/y", "allowed": false}]},
    {"name": "keys are case-insensitive, values are not", "robots": "USER-AGENT: A\nDISALLOW: /Private\n", "checks": [{"agent": "a", "path": "/private", "allowed": true}, {"agent": "a", "path": "/Private", "allowed": false}]},
    {"name": "empty path means root", "robots": "User-agent: *\nDisallow: /$\n", "checks": [{"agent": "x", "path": "", "allowed": false}, {"agent": "x", "path": "/a", "allowed": true}]},
    {"name": "pattern without leading slash matches nothing", "robots": "User-agent: *\nDisallow: private\n", "diags": ["invalid_pattern"], "checks": [{"agent": "x", "path": "/private", "allowed": true}]},
    {"name": "500 KiB limit ignores the rest", "robots_prefix_pad": 512000, "robots": "User-agent: *\nDisallow: /\n", "diags": ["input_too_large"], "grade": "partial",
     "checks": [{"agent": "x", "path": "/a", "allowed": true}]},
    {"name": "item limit", "robots": "User-agent: *\nDisallow: /a\nDisallow: /b\nDisallow: /c\n", "options": {"max_items": 2}, "diags": ["limit_exceeded"], "grade": "partial",
     "checks": [{"agent": "x", "path": "/b", "allowed": false}, {"agent": "x", "path": "/c", "allowed": true}]}
  ]
}
