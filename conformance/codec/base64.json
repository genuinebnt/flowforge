{
  "description": "Strict and lenient base64 decoding edge cases (op decode). `mode` is strict, lenient or both (both modes give the same result). Every case also runs against every Base64Algo candidate.",
  "source": "RFC 4648 §3.2 (padding), §3.3 (non-alphabet characters), §3.5 (canonical encoding), §4, §5; RFC 2045 §6.8 (MIME line breaks)",
  "cases": [
    {
      "name": "non-zero trailing bits in a 1-byte quantum",
      "codec": "base64",
      "mode": "strict",
      "encoded": "Zh==",
      "error": "trailing_bits",
      "offset": 1
    },
    {
      "name": "lenient ignores trailing bits",
      "codec": "base64",
      "mode": "lenient",
      "encoded": "Zh==",
      "decoded": "f"
    },
    {
      "name": "non-zero trailing bits in a 2-byte quantum",
      "codec": "base64",
      "mode": "strict",
      "encoded": "Zm9=",
      "error": "trailing_bits",
      "offset": 2
    },
    {
      "name": "missing padding",
      "codec": "base64",
      "mode": "strict",
      "encoded": "Zg",
      "error": "bad_padding",
      "offset": 2
    },
    {
      "name": "lenient accepts missing padding",
      "codec": "base64",
      "mode": "lenient",
      "encoded": "Zm8",
      "decoded": "fo"
    },
    {
      "name": "partial padding",
      "codec": "base64",
      "mode": "strict",
      "encoded": "Zg=",
      "error": "bad_padding",
      "offset": 3
    },
    {
      "name": "lenient accepts partial padding",
      "codec": "base64",
      "mode": "lenient",
      "encoded": "Zg=",
      "decoded": "f"
    },
    {
      "name": "single character quantum",
      "codec": "base64",
      "mode": "both",
      "encoded": "Zm9vY",
      "error": "truncated",
      "offset": 5
    },
    {
      "name": "data after padding",
      "codec": "base64",
      "mode": "both",
      "encoded": "Zg==Zg==",
      "error": "bad_padding",
      "offset": 4
    },
    {
      "name": "padding at the start of a quantum",
      "codec": "base64",
      "mode": "both",
      "encoded": "Zm9v=",
      "error": "bad_padding",
      "offset": 4
    },
    {
      "name": "padding after one character",
      "codec": "base64",
      "mode": "both",
      "encoded": "Z===",
      "error": "bad_padding",
      "offset": 1
    },
    {
      "name": "third padding character",
      "codec": "base64",
      "mode": "both",
      "encoded": "Zg===",
      "error": "bad_padding",
      "offset": 4
    },
    {
      "name": "CRLF line break is not base64 in strict mode",
      "codec": "base64",
      "mode": "strict",
      "encoded": "Zm9v\r\nYmFy",
      "error": "invalid_byte",
      "offset": 4
    },
    {
      "name": "MIME line break skipped",
      "codec": "base64",
      "mode": "lenient",
      "encoded": "Zm9v\r\nYmFy",
      "decoded": "foobar"
    },
    {
      "name": "white space anywhere, padding included",
      "codec": "base64",
      "mode": "lenient",
      "encoded": " Z g =\t\n= ",
      "decoded": "f"
    },
    {
      "name": "byte outside the alphabet",
      "codec": "base64",
      "mode": "both",
      "encoded": "Zm9v!",
      "error": "invalid_byte",
      "offset": 4
    },
    {
      "name": "URL alphabet character in standard strict",
      "codec": "base64",
      "mode": "strict",
      "encoded": "-_8=",
      "error": "invalid_byte",
      "offset": 0
    },
    {
      "name": "URL alphabet",
      "codec": "base64url",
      "mode": "strict",
      "encoded": "-_8=",
      "decoded_hex": "fbff"
    },
    {
      "name": "standard alphabet character in URL strict",
      "codec": "base64url",
      "mode": "strict",
      "encoded": "+/8=",
      "error": "invalid_byte",
      "offset": 0
    },
    {
      "name": "lenient mixes both alphabets",
      "codec": "base64",
      "mode": "lenient",
      "encoded": "+/-_",
      "decoded_hex": "fbffbf"
    },
    {
      "name": "padding in unpadded strict",
      "codec": "base64-nopad",
      "mode": "strict",
      "encoded": "Zg==",
      "error": "bad_padding",
      "offset": 2
    },
    {
      "name": "unpadded strict trailing bits",
      "codec": "base64-nopad",
      "mode": "strict",
      "encoded": "Zh",
      "error": "trailing_bits",
      "offset": 1
    },
    {
      "name": "lenient unpadded accepts padding",
      "codec": "base64-nopad",
      "mode": "lenient",
      "encoded": "Zg==",
      "decoded": "f"
    },
    {
      "name": "all byte values",
      "codec": "base64",
      "mode": "both",
      "encoded": "",
      "decoded_hex": ""
    }
  ]
}
