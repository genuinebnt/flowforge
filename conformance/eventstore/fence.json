{
  "name": "fence",
  "spec": "23.4 property (2); 9.4; es_003",
  "description": "An append carrying an older fence fails with fenced even if expected_seq matches; fenced is reported before a seq conflict; fences never issued and released fences cannot append.",
  "steps": [
    {"op": "create", "run": "r1"},
    {"op": "append", "run": "r1", "fence": {"term": 0, "counter": 0}, "expected_seq": 0,
     "events": [{"type": "log", "actor": "engine"}], "expect": {"error": "fenced"}},
    {"op": "acquire", "run": "r1", "worker": "w1", "as": "L1"},
    {"op": "append", "run": "r1", "lease": "L1", "expected_seq": 0,
     "events": [{"type": "log", "actor": "engine", "payload": {"by": "L1"}}], "expect": {"head": 1}},
    {"op": "acquire", "run": "r1", "worker": "w1", "as": "L2", "expect": {"fence_greater_than": "L1"}},
    {"op": "append", "run": "r1", "lease": "L1", "expected_seq": 1,
     "events": [{"type": "log", "actor": "engine", "payload": {"by": "L1"}}], "expect": {"error": "fenced"}},
    {"op": "append", "run": "r1", "lease": "L1", "expected_seq": 0,
     "events": [{"type": "log", "actor": "engine", "payload": {"by": "L1"}}], "expect": {"error": "fenced"}},
    {"op": "append", "run": "r1", "fence": {"term": 9, "counter": 0}, "expected_seq": 1,
     "events": [{"type": "log", "actor": "engine"}], "expect": {"error": "fenced"}},
    {"op": "renew", "run": "r1", "lease": "L1", "expect": {"error": "fenced"}},
    {"op": "release", "run": "r1", "lease": "L1", "expect": {"error": "fenced"}},
    {"op": "append", "run": "r1", "lease": "L2", "expected_seq": 1,
     "events": [{"type": "log", "actor": "engine", "payload": {"by": "L2"}}], "expect": {"head": 2}},
    {"op": "release", "run": "r1", "lease": "L2", "status": "waiting"},
    {"op": "append", "run": "r1", "lease": "L2", "expected_seq": 2,
     "events": [{"type": "log", "actor": "engine", "payload": {"by": "L2"}}], "expect": {"error": "fenced"}},
    {"op": "get_run", "run": "r1", "expect": {"head": 2, "status": "waiting", "owner": ""}},
    {"op": "read", "run": "r1", "expect": {"events": [
      {"seq": 1, "type": "log", "actor": "engine", "payload": {"by": "L1"}},
      {"seq": 2, "type": "log", "actor": "engine", "payload": {"by": "L2"}}
    ]}},
    {"op": "acquire", "run": "r1", "worker": "w2", "as": "L3", "expect": {"fence_greater_than": "L2"}},
    {"op": "append", "run": "r1", "lease": "L3", "expected_seq": 2,
     "events": [{"type": "log", "actor": "engine", "payload": {"by": "L3"}}], "expect": {"head": 3}}
  ]
}
