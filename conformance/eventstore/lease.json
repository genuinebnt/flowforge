{
  "name": "lease",
  "spec": "23.4 property (4); 9.4; 9.9; 23.8 worker paused; es_004",
  "description": "A held lease blocks other workers until it expires; renewal extends it; after takeover the old holder's append, renew and release fail with fenced. An expired lease that nobody replaced still appends.",
  "steps": [
    {"op": "create", "run": "r1"},
    {"op": "acquire", "run": "r1", "worker": "w1", "ttl_ms": 30000, "as": "L1"},
    {"op": "acquire", "run": "r1", "worker": "w2", "expect": {"error": "lease_held"}},
    {"op": "elapse", "ms": 20000},
    {"op": "acquire", "run": "r1", "worker": "w2", "expect": {"error": "lease_held"}},
    {"op": "renew", "run": "r1", "lease": "L1", "ttl_ms": 30000, "as": "L1"},
    {"op": "elapse", "ms": 25000},
    {"op": "acquire", "run": "r1", "worker": "w2", "expect": {"error": "lease_held"}},
    {"op": "elapse", "ms": 10000},
    {"op": "append", "run": "r1", "lease": "L1", "expected_seq": 0,
     "events": [{"type": "log", "actor": "engine", "payload": {"note": "expired but not replaced"}}], "expect": {"head": 1}},
    {"op": "list_ready", "expect": {"runs": ["r1"]}},
    {"op": "acquire", "run": "r1", "worker": "w2", "ttl_ms": 30000, "as": "L2", "expect": {"fence_greater_than": "L1"}},
    {"op": "list_ready", "expect": {"runs": []}},
    {"op": "append", "run": "r1", "lease": "L1", "expected_seq": 1,
     "events": [{"type": "log", "actor": "engine"}], "expect": {"error": "fenced"}},
    {"op": "renew", "run": "r1", "lease": "L1", "expect": {"error": "fenced"}},
    {"op": "release", "run": "r1", "lease": "L1", "expect": {"error": "fenced"}},
    {"op": "get_run", "run": "r1", "expect": {"owner": "w2", "head": 1}},
    {"op": "acquire", "run": "r1", "worker": "w1", "expect": {"error": "lease_held"}},
    {"op": "acquire", "run": "r1", "worker": "w2", "as": "L3", "expect": {"fence_greater_than": "L2"}},
    {"op": "append", "run": "r1", "lease": "L2", "expected_seq": 1,
     "events": [{"type": "log", "actor": "engine"}], "expect": {"error": "fenced"}},
    {"op": "release", "run": "r1", "lease": "L3"},
    {"op": "acquire", "run": "r1", "worker": "w1", "as": "L4", "expect": {"fence_greater_than": "L3"}},
    {"op": "acquire", "run": "ghost", "worker": "w1", "expect": {"error": "not_found"}},
    {"op": "acquire", "run": "r1", "worker": "", "expect": {"error": "invalid"}}
  ]
}
