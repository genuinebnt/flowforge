{
 "description": "Redirect and CNAME chains are re-checked hop by hop and stop at the first deny (spec 4.5).",
 "scope": {
  "version": 1,
  "rules": [
   {
    "id": "sub",
    "effect": "allow",
    "kind": "wildcard_domain",
    "value": "*.acme.com"
   },
   {
    "id": "pay",
    "effect": "deny",
    "kind": "domain",
    "value": "pay.acme.com"
   },
   {
    "id": "internal",
    "effect": "deny",
    "kind": "cidr",
    "value": "192.0.2.0/24"
   }
  ],
  "activity": {
   "max_class": "active",
   "windows": []
  }
 },
 "resolver": {
  "www.acme.com": [
   "203.0.113.5"
  ],
  "login.acme.com": [
   "203.0.113.6"
  ],
  "cdn.acme.com": [
   "192.0.2.7"
  ],
  "evil.example": [
   "198.51.100.1"
  ]
 },
 "cases": [
  {
   "id": "scope_015a",
   "target": "https://www.acme.com/",
   "kind": "url",
   "class": "active",
   "hops": [
    {
     "target": "https://login.acme.com/sso",
     "kind": "url"
    }
   ],
   "expect": {
    "result": "allow",
    "reason": "allow",
    "rule_id": "sub",
    "checked": 2,
    "pinned_ips": [
     "203.0.113.6"
    ]
   }
  },
  {
   "id": "scope_015b",
   "target": "https://www.acme.com/",
   "kind": "url",
   "class": "active",
   "hops": [
    {
     "target": "https://login.acme.com/sso",
     "kind": "url"
    },
    {
     "target": "https://evil.example/phish",
     "kind": "url"
    }
   ],
   "expect": {
    "result": "deny",
    "reason": "no_matching_allow",
    "checked": 3
   }
  },
  {
   "id": "scope_015c",
   "target": "https://www.acme.com/",
   "kind": "url",
   "class": "active",
   "hops": [
    {
     "target": "https://PAY.acme.com/checkout",
     "kind": "url"
    }
   ],
   "expect": {
    "result": "deny",
    "reason": "explicit_deny",
    "rule_id": "pay",
    "checked": 2
   }
  },
  {
   "id": "scope_015d",
   "target": "www.acme.com",
   "class": "active",
   "hops": [
    {
     "target": "cdn.acme.com",
     "kind": "host"
    }
   ],
   "expect": {
    "result": "deny",
    "reason": "resolved_ip_denied",
    "rule_id": "internal",
    "checked": 2
   }
  },
  {
   "id": "scope_015e",
   "target": "https://www.acme.com/",
   "kind": "url",
   "class": "active",
   "hops": [
    {
     "target": "https://evil.example/",
     "kind": "url"
    },
    {
     "target": "https://login.acme.com/",
     "kind": "url"
    }
   ],
   "expect": {
    "result": "deny",
    "reason": "no_matching_allow",
    "checked": 2
   }
  },
  {
   "id": "scope_015f",
   "target": "https://evil.example/",
   "kind": "url",
   "class": "active",
   "hops": [
    {
     "target": "https://www.acme.com/",
     "kind": "url"
    }
   ],
   "expect": {
    "result": "deny",
    "reason": "no_matching_allow",
    "checked": 1
   }
  },
  {
   "id": "scope_015g",
   "target": "https://www.acme.com/",
   "kind": "url",
   "class": "active",
   "hops": [
    {
     "target": "https://www.acme.com@evil.example/",
     "kind": "url"
    }
   ],
   "expect": {
    "result": "deny",
    "reason": "invalid_target",
    "checked": 2
   }
  },
  {
   "id": "scope_015h",
   "target": "https://www.acme.com/",
   "kind": "url",
   "class": "passive",
   "hops": [
    {
     "target": "https://evil.example/"
    }
   ],
   "expect": {
    "result": "deny",
    "reason": "no_matching_allow",
    "checked": 2
   }
  }
 ]
}
