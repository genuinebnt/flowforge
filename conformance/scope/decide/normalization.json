{
 "description": "Normalization before matching (spec 4.2, 4.5): case, trailing dots, IDNA lookalikes, bad names, URL tricks, non-canonical IPv4.",
 "scope": {
  "version": 3,
  "rules": [
   {
    "id": "apex",
    "effect": "allow",
    "kind": "domain",
    "value": "acme.com"
   },
   {
    "id": "sub",
    "effect": "allow",
    "kind": "wildcard_domain",
    "value": "*.acme.com"
   },
   {
    "id": "apple",
    "effect": "allow",
    "kind": "domain",
    "value": "apple.com"
   },
   {
    "id": "idn",
    "effect": "allow",
    "kind": "domain",
    "value": "bücher.example",
    "note": "written in Unicode, stored as an A-label"
   }
  ],
  "activity": {
   "max_class": "active",
   "windows": []
  }
 },
 "resolver": {
  "acme.com": [
   "203.0.113.10"
  ],
  "www.acme.com": [
   "203.0.113.11"
  ]
 },
 "cases": [
  {
   "id": "scope_001a",
   "target": " WWW.Acme.COM. ",
   "class": "passive",
   "expect": {
    "result": "allow",
    "reason": "allow",
    "rule_id": "sub",
    "target": "www.acme.com"
   }
  },
  {
   "id": "scope_001b",
   "target": "www.acme.com",
   "class": "passive",
   "expect": {
    "result": "allow",
    "reason": "allow",
    "rule_id": "sub",
    "target": "www.acme.com"
   }
  },
  {
   "id": "scope_001c",
   "target": "ACME.COM.",
   "class": "active",
   "expect": {
    "result": "allow",
    "reason": "allow",
    "rule_id": "apex",
    "target": "acme.com",
    "pinned_ips": [
     "203.0.113.10"
    ]
   }
  },
  {
