{
 "description": "A passive-only program refuses active work everywhere and still answers passive checks.",
 "scope": {
  "version": 1,
  "rules": [
   {
    "id": "sub",
    "effect": "allow",
    "kind": "wildcard_domain",
    "value": "*.acme.com"
   }
  ],
  "activity": {
   "max_class": "passive",
   "windows": []
  }
 },
 "cases": [
  {
   "id": "scope_012d",
   "target": "www.acme.com",
   "class": "active",
   "expect": {
    "result": "deny",
    "reason": "class_exceeds_program"
   }
  },
  {
   "id": "scope_012e",
   "target": "www.acme.com",
   "class": "passive",
   "expect": {
    "result": "allow",
    "reason": "allow",
    "rule_id": "sub"
   }
  }
 ]
}
