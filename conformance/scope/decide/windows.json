{
 "description": "Testing windows: boundaries (start inclusive, end exclusive), a window across midnight in a DST zone, a 24:00 end, and passive checks ignoring windows. Checks here do not resolve.",
 "scope": {
  "version": 1,
  "rules": [
   {
    "id": "sub",
    "effect": "allow",
    "kind": "wildcard_domain",
    "value": "*.acme.com"
   }
  ],
  "activity": {
   "max_class": "active",
   "windows": [
    {
     "days": [
      "mon",
      "tue",
      "wed",
      "thu",
      "fri"
     ],
     "start": "09:00",
     "end": "18:00",
     "tz": "UTC"
    },
    {
     "days": [
      "sat"
     ],
     "start": "22:00",
     "end": "02:00",
     "tz": "America/New_York"
    },
    {
     "days": [
      "sun"
     ],
     "start": "20:00",
     "end": "24:00",
     "tz": "Asia/Kolkata"
    }
   ]
  }
 },
 "cases": [
  {
   "id": "scope_013a",
   "target": "www.acme.com",
   "class": "active",
   "now": "2026-11-12T08:59:59.999Z",
   "expect": {
    "result": "deny",
    "reason": "outside_window"
   }
  },
  {
   "id": "scope_013b",
   "target": "www.acme.com",
   "class": "active",
   "now": "2026-11-12T09:00:00.000Z",
   "expect": {
    "result": "allow",
    "reason": "allow",
    "rule_id": "sub"
   }
  },
  {
