{
  "id": "lim_005_counter",
  "model": "sliding_window_counter",
  "comment": "L = 4, W = 1000 ms: a full window ending at 900 ms blocks the start of the next window; the previous window's weight then decays linearly",
  "config": { "rate_per_s": 4, "burst": 4, "window_ms": 1000 },
  "steps": [
    { "t_ms": 900,  "cost": 1, "expect": { "allow": true, "remaining": 3 } },
    { "t_ms": 900,  "cost": 1, "expect": { "allow": true, "remaining": 2 } },
    { "t_ms": 900,  "cost": 1, "expect": { "allow": true, "remaining": 1 } },
    { "t_ms": 900,  "cost": 1, "expect": { "allow": true, "remaining": 0 } },
    { "t_ms": 900,  "cost": 1, "expect": { "allow": false, "retry_after_ms": 350 } },
    { "t_ms": 1000, "cost": 1, "expect": { "allow": false, "retry_after_ms": 250 } },
    { "t_ms": 1100, "cost": 1, "expect": { "allow": false, "retry_after_ms": 150 } },
    { "t_ms": 1250, "cost": 1, "expect": { "allow": true, "remaining": 0 } },
    { "t_ms": 1500, "cost": 1, "expect": { "allow": true, "remaining": 0 } },
    { "t_ms": 1500, "cost": 1, "expect": { "allow": false, "retry_after_ms": 250 } },
    { "t_ms": 3000, "cost": 1, "expect": { "allow": true, "remaining": 3 } },
    { "t_ms": 3000, "cost": 5, "expect": { "allow": false, "error": "cost_exceeds_capacity" } }
  ]
}
