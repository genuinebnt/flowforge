{
 "description": "crt.sh overloaded: a retryable unavailable error.",
 "input": "example.com",
 "scope": {
  "allow": [
   "example.com",
   "*.example.com"
  ]
 },
 "http": [
  {
   "url": "https://crt.sh/?q=%25.example.com&output=json",
   "status": 502,
   "headers": {
    "Content-Type": "text/html"
   },
   "body_text": "<html>502 Bad Gateway</html>"
  }
 ],
 "expect": {
  "error": "unavailable",
  "retryable": true,
  "skipped": [],
  "requests": [
   "https://crt.sh/?q=%25.example.com\u0026output=json"
  ],
  "dials": [],
  "dns_queries": [],
  "observations": []
 }
}
