{
  "description": "URL reference extraction with context: url() tokens and functions, @import, @namespace, image-set(), @font-face src.",
  "cases": [
    {"name": "import string", "parser": "urls", "input": "@import \"a.css\" screen;",
     "urls": [{"url": "a.css", "form": "string", "context": "import", "text": "\"a.css\""}], "grade": "complete"},
    {"name": "import url token", "parser": "urls", "input": "@import url(b.css) layer(x);",
     "urls": [{"url": "b.css", "form": "token", "context": "import", "text": "url(b.css)"}]},
    {"name": "import url function", "parser": "urls", "input": "@IMPORT url( 'c.css' ) supports(display:grid);",
     "urls": [{"url": "c.css", "form": "function", "context": "import", "text": "url( 'c.css' )"}]},
    {"name": "only the first import component is the target", "parser": "urls", "input": "@import 'a' 'b';",
     "urls": [{"url": "a", "form": "string", "context": "import"}]},
    {"name": "namespace", "parser": "urls", "input": "@namespace svg url(http://www.w3.org/2000/svg);",
     "urls": [{"url": "http://www.w3.org/2000/svg", "form": "token", "context": "namespace"}]},
    {"name": "background and escapes", "parser": "urls", "input": "a{background:url(x\\29y.png) no-repeat}",
     "urls": [{"url": "x)y.png", "form": "token", "context": "value", "text": "url(x\\29y.png)"}]},
    {"name": "strings in values are not urls", "parser": "urls", "input": "a{content:\"x.png\"}", "urls": []},
    {"name": "image-set strings and urls", "parser": "urls", "input": "a{b:image-set(\"a.png\" 1x, url(b.png) 2x, -webkit-image-set('c.png' 1x))}",
     "urls": [{"url": "a.png", "form": "string", "context": "image-set"}, {"url": "b.png", "form": "token", "context": "image-set"}, {"url": "c.png", "form": "string", "context": "image-set"}]},
    {"name": "font-face src", "parser": "urls", "input": "@font-face{font-family:x;src:local(x),url(f.woff2) format('woff2'),url(\"f.woff\")}",
     "urls": [{"url": "f.woff2", "form": "token", "context": "font-face-src"}, {"url": "f.woff", "form": "function", "context": "font-face-src"}]},
    {"name": "font-face inside media", "parser": "urls", "input": "@media print{@font-face{src:url(p.woff)} a{b:url(q.png)}}",
     "urls": [{"url": "p.woff", "form": "token", "context": "font-face-src"}, {"url": "q.png", "form": "token", "context": "value"}]},
    {"name": "other font-face descriptors", "parser": "urls", "input": "@font-face{x:url(n.png);src:url(s.woff)}",
     "urls": [{"url": "n.png", "form": "token", "context": "value"}, {"url": "s.woff", "form": "token", "context": "font-face-src"}]},
    {"name": "src function", "parser": "urls", "input": "a{b:src(\"s.png\")}",
     "urls": [{"url": "s.png", "form": "function", "context": "value", "text": "src(\"s.png\")"}]},
    {"name": "nested style rules", "parser": "urls", "input": "a{&:hover{b:url(h.png)}}",
     "urls": [{"url": "h.png", "form": "token", "context": "value"}]},
    {"name": "bad url is not a reference", "parser": "urls", "input": "a{b:url(x y)}", "urls": []},
    {"name": "urls in preludes and invalid rules", "parser": "urls", "input": "x url(p.png) { } url(e.png)",
     "urls": [{"url": "p.png", "form": "token", "context": "value"}, {"url": "e.png", "form": "token", "context": "value"}]},
    {"name": "unterminated url at eof", "parser": "urls", "input": "a{b:url(z.png",
     "urls": [{"url": "z.png", "form": "token", "context": "value"}], "grade": "complete"}
  ]
}
