{
  "description": "CSS Syntax 3 (current) tokenization and parsing, without the legacy tokens of the 2014 CR. Expected values use the css-parsing-tests representation.",
  "cases": [
    {"name": "match tokens are two delims", "parser": "component_value_list", "input": "~=|=^=$=*=||",
     "expected": ["~", "=", "|", "=", "^", "=", "$", "=", "*", "=", "|", "|"]},
    {"name": "unicode-range is ident plus number", "parser": "component_value_list", "input": "U+26 u+0-7F",
     "expected": [["ident", "U"], ["number", "+26", 26, "integer"], " ", ["ident", "u"], ["number", "+0", 0, "integer"], ["dimension", "-7", -7, "integer", "F"]]},
    {"name": "u+? is ident delim delim", "parser": "component_value_list", "input": "u+?",
     "expected": [["ident", "u"], "+", "?"]},
    {"name": "crlf and form feed are newlines", "parser": "component_value_list", "input": "a\r\n\fb\rc",
     "expected": [["ident", "a"], " ", ["ident", "b"], " ", ["ident", "c"]]},
    {"name": "string escape of crlf continues the string", "parser": "component_value_list", "input": "'a\\\r\nb'",
     "expected": [["string", "ab"]]},
    {"name": "hex escape eats one crlf", "parser": "component_value_list", "input": "\\41\r\nB",
     "expected": [["ident", "AB"]]},
    {"name": "nul becomes replacement", "parser": "component_value_list", "input": "a\u0000b",
     "expected": [["ident", "a\uFFFDb"]]},
    {"name": "surrogate and out-of-range escapes", "parser": "component_value_list", "input": "\\D800 \\110000 \\0 x",
     "expected": [["ident", "\uFFFD\uFFFD\uFFFDx"]]},
    {"name": "backslash newline is a delim", "parser": "component_value_list", "input": "a\\\nb",
     "expected": [["ident", "a"], "\\", " ", ["ident", "b"]], "diags": ["invalid_escape"]},
    {"name": "backslash at eof", "parser": "component_value_list", "input": "a\\",
     "expected": [["ident", "a\uFFFD"]], "diags": ["eof_in_escape"]},
    {"name": "unterminated comment", "parser": "component_value_list", "input": "a/* b",
     "expected": [["ident", "a"]], "diags": ["eof_in_comment"]},
    {"name": "exponent needs digits", "parser": "component_value_list", "input": "1e 1e+ 1e+5",
     "expected": [["dimension", "1", 1, "integer", "e"], " ", ["dimension", "1", 1, "integer", "e"], "+", " ", ["number", "1e+5", 100000, "number"]]},
    {"name": "percent and dimension types", "parser": "component_value_list", "input": "1.0% 2px -.5em",
     "expected": [["percentage", "1.0", 1, "number"], " ", ["dimension", "2", 2, "integer", "px"], " ", ["dimension", "-.5", -0.5, "number", "em"]]},
    {"name": "CDO and CDC", "parser": "component_value_list", "input": "<!-- -->",
     "expected": ["<!--", " ", "-->"]},
    {"name": "url with whitespace and escapes", "parser": "component_value_list", "input": "url(  a\\)b  )",
     "expected": [["url", "a)b"]]},
    {"name": "url( then whitespace then quote is a function", "parser": "component_value_list", "input": "url(  \"x\" )",
     "expected": [["function", "url", " ", ["string", "x"], " "]]},
    {"name": "bad url recovers at close paren", "parser": "component_value_list", "input": "url(a b) c",
     "expected": [["error", "bad-url"], " ", ["ident", "c"]], "diags": ["bad_url"]},
    {"name": "bad string recovers at newline", "parser": "component_value_list", "input": "\"a\nb",
     "expected": [["error", "bad-string"], " ", ["ident", "b"]], "diags": ["newline_in_string"]},
    {"name": "hash types", "parser": "component_value_list", "input": "#a #1 #- #-a #",
     "expected": [["hash", "a", "id"], " ", ["hash", "1", "unrestricted"], " ", ["hash", "-", "unrestricted"], " ", ["hash", "-a", "id"], " ", "#"]},
    {"name": "at-keyword needs an ident start", "parser": "component_value_list", "input": "@1 @-- @",
     "expected": ["@", ["number", "1", 1, "integer"], " ", ["at-keyword", "--"], " ", "@"]},
    {"name": "unclosed blocks at eof", "parser": "component_value_list", "input": "f([{",
     "expected": [["function", "f", ["[]", ["{}"]]]], "diags": ["eof_in_block"]},
    {"name": "mismatched close is preserved", "parser": "component_value_list", "input": "(])",
     "expected": [["()", ["error", "]"]]]},
    {"name": "important with comments and case", "parser": "one_declaration", "input": "a:b ! /**/ IMPORTANT",
     "expected": ["declaration", "a", [["ident", "b"], " "], true]},
    {"name": "important must be last", "parser": "one_declaration", "input": "a:!important b",
     "expected": ["declaration", "a", ["!", ["ident", "important"], " ", ["ident", "b"]], false]},
    {"name": "custom property keeps braces", "parser": "blocks_contents", "input": "--x:{a b};c:d",
     "expected": [["declaration", "--x", [["{}", ["ident", "a"], " ", ["ident", "b"]]], false], ["declaration", "c", [["ident", "d"]], false]]},
    {"name": "nested rule with ampersand", "parser": "blocks_contents", "input": "color:red;&:hover{color:blue}",
     "expected": [["declaration", "color", [["ident", "red"]], false], ["qualified rule", ["&", ":", ["ident", "hover"]], [["ident", "color"], ":", ["ident", "blue"]]]]},
    {"name": "stray close brace in block contents", "parser": "blocks_contents", "input": "a:b}c:d",
     "expected": [["declaration", "a", [["ident", "b"]], false], ["error", "invalid"], ["declaration", "c", [["ident", "d"]], false]],
     "diags": ["unexpected_close"]},
    {"name": "at-rule without block ends at eof", "parser": "stylesheet", "input": "@charset \"utf-8\"",
     "expected": [["at-rule", "charset", [" ", ["string", "utf-8"]], null]], "diags": ["eof_in_at_rule"]},
    {"name": "qualified rule at eof is invalid", "parser": "stylesheet", "input": "a b",
     "expected": [["error", "invalid"]], "diags": ["invalid_rule"]},
    {"name": "empty input", "parser": "stylesheet", "input": "", "expected": [], "diags": [], "grade": "complete"}
  ]
}
