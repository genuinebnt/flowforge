{
 "description": "alr_002 data: dedupe keys and throttle windows with a FakeClock (advance is applied before the step's event).",
 "cases": [
  {
   "name": "throttle without group_by uses one key",
   "rule": "alert th when event.type == \"run.run_failed\" -> slack() throttle 1h",
   "steps": [
    {
     "event": {
      "type": "run.run_failed",
      "tenant_id": "ten_1",
      "run": {
       "id": "run_1",
       "type": "run_failed",
       "workflow_name": "a",
       "code": "X"
      }
     },
     "outcome": "alert",
     "key": "k"
    },
    {
     "advance": "1m",
     "event": {
      "type": "run.run_failed",
      "tenant_id": "ten_1",
      "run": {
       "id": "run_1",
       "type": "run_failed",
       "workflow_name": "b",
       "code": "X"
      }
     },
     "outcome": "suppressed",
     "key": "k"
    },
    {
     "advance": "58m59s",
     "event": {
      "type": "run.run_failed",
      "tenant_id": "ten_1",
      "run": {
       "id": "run_1",
       "type": "run_failed",
       "workflow_name": "c",
       "code": "X"
      }
     },
     "outcome": "suppressed",
     "key": "k"
    },
    {
     "advance": "1s",
     "event": {
      "type": "run.run_failed",
      "tenant_id": "ten_1",
      "run": {
       "id": "run_1",
       "type": "run_failed",
       "workflow_name": "d",
       "code": "X"
      }
     },
     "outcome": "alert",
     "key": "k",
     "suppressed_count": 2
    }
   ]
  },
  {
   "name": "group_by splits keys",
   "rule": "alert th when event.type == \"run.run_failed\" -> slack() group_by run.workflow_name, run.code throttle 10m",
