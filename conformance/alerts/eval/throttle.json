      "type": "run.run_failed",
      "tenant_id": "ten_1",
      "run": {
       "id": "run_1",
       "type": "run_failed",
       "workflow_name": "a",
       "code": "Y"
      }
     },
     "outcome": "alert",
     "key": "aY"
