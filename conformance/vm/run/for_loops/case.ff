// Nested for loops with lets in the body, a for over a list of tuples
// with a destructuring pattern, and an early return from a fn.
fn find(xs: List<Int>, target: Int) -> Int {
  for (i, x) in enumerate(xs) {
    if x == target { return i; }
  }
  -1
}
workflow main() -> List<Int> {
  for i in 0..3 {
    let sq = i * i;
    for j in 0..sq {
      let k = i + j;
      k;
    }
  }
  [find([4, 5, 6], 6), find([4, 5, 6], 7), find([], 1)]
}
