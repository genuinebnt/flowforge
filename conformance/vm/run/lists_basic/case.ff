// List indexing, ranges and the sequence builtins.
workflow main() -> List<List<Int>> {
  let xs = [5, 3, 5, 1, 3, 9];
  let r = 0..4;
  let pairs = zip(xs, r);
  let firsts = pairs |> map(p => match p { (a, _) => a });
  let idx = enumerate(xs) |> map(p => match p { (i, _) => i });
  [take(xs, 2), skip(xs, 4), reverse(xs), concat(r, [10]), dedupe(xs), firsts, idx,
   [xs[0], xs[5], len(xs), len(r)], 3..3, 5..2]
}
