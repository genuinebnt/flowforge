// User enums, exhaustive match with guards, nested patterns and
// literal patterns; guards do not count toward exhaustiveness.
enum Shape { Circle(Int), Rect(Int, Int), Tagged(String, Shape), Empty }
fn area(s: Shape) -> Int {
  match s {
    Shape::Circle(r) if r > 10 => 999,
    Shape::Circle(r) => 3 * r * r,
    Shape::Rect(w, h) if w == h => w * w,
    Shape::Rect(w, h) => w * h,
    Shape::Tagged("zero", _) => 0,
    Shape::Tagged(_, inner) => area(inner),
    Shape::Empty => -1,
  }
}
workflow main() -> List<Int> {
  let shapes = [Shape::Circle(2), Shape::Circle(11), Shape::Rect(3, 3), Shape::Rect(2, 5),
                Shape::Tagged("zero", Shape::Rect(9, 9)), Shape::Tagged("t", Shape::Tagged("u", Shape::Circle(1))), Shape::Empty];
  shapes |> map(area)
}
