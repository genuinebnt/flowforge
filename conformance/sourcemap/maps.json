{
  "description": "Whole source maps (ECMA-426): regular and index maps, sources resolution, sourcesContent, ignoreList, errors and grades. lookups give a generated (line, col) and the expected original position, or found=false.",
  "cases": [
    {"name": "ECMA-426 example", "text": "{\"version\":3,\"file\":\"out.js\",\"sourceRoot\":\"\",\"sources\":[\"foo.js\",\"bar.js\"],\"sourcesContent\":[null,null],\"names\":[\"src\",\"maps\",\"are\",\"fun\"],\"mappings\":\"A,AAAC;;AACDE\"}",
     "grade": "complete", "map_url": "https://example.com/js/out.js.map", "resolved": ["https://example.com/js/foo.js", "https://example.com/js/bar.js"],
     "lookups": [{"line": 0, "col": 9, "found": true, "source": 0, "orig_line": 0, "orig_col": 1, "name": -1},
                 {"line": 1, "col": 0, "found": false},
                 {"line": 2, "col": 3, "found": true, "source": 0, "orig_line": 1, "orig_col": 0, "name": 2}]},
    {"name": "sourceRoot and content", "text": "{\"version\":3,\"sourceRoot\":\"src\",\"sources\":[\"a.ts\",null,\"https://cdn.example/b.ts\"],\"sourcesContent\":[\"let a = 1\"],\"names\":[],\"mappings\":\"AAAA\",\"ignoreList\":[2]}",
     "grade": "complete", "map_url": "https://example.com/static/app.js.map", "resolved": ["https://example.com/static/src/a.ts", "", "https://cdn.example/b.ts"],
     "contents": ["let a = 1", null, null], "ignored": [false, false, true]},
    {"name": "XSSI prefix is skipped", "text": ")]}'\n{\"version\":3,\"sources\":[\"a.js\"],\"names\":[],\"mappings\":\"AAAA\"}", "grade": "complete", "mapping_count": 1},
    {"name": "index map flattens sections", "text": "{\"version\":3,\"file\":\"app.js\",\"sections\":[{\"offset\":{\"line\":0,\"column\":0},\"map\":{\"version\":3,\"sources\":[\"one.js\"],\"names\":[\"x\"],\"mappings\":\"AAAAA,CAAC\"}},{\"offset\":{\"line\":1,\"column\":10},\"map\":{\"version\":3,\"sourceRoot\":\"lib/\",\"sources\":[\"two.js\"],\"names\":[],\"mappings\":\"AAAA;AACA\"}}]}",
     "grade": "complete", "resolved": ["one.js", "lib/two.js"], "mapping_count": 4,
     "lookups": [{"line": 0, "col": 1, "found": true, "source": 0, "orig_line": 0, "orig_col": 1, "name": -1},
                 {"line": 1, "col": 9, "found": false},
                 {"line": 1, "col": 12, "found": true, "source": 1, "orig_line": 0, "orig_col": 0, "name": -1},
                 {"line": 2, "col": 0, "found": true, "source": 1, "orig_line": 1, "orig_col": 0, "name": -1}]},
    {"name": "sections out of order", "text": "{\"version\":3,\"sections\":[{\"offset\":{\"line\":1,\"column\":0},\"map\":{\"version\":3,\"sources\":[],\"mappings\":\"\"}},{\"offset\":{\"line\":0,\"column\":5},\"map\":{\"version\":3,\"sources\":[],\"mappings\":\"\"}}]}", "error": "section_order", "grade": "failed"},
    {"name": "equal section offsets", "text": "{\"version\":3,\"sections\":[{\"offset\":{\"line\":0,\"column\":0},\"map\":{\"version\":3,\"sources\":[],\"mappings\":\"\"}},{\"offset\":{\"line\":0,\"column\":0},\"map\":{\"version\":3,\"sources\":[],\"mappings\":\"\"}}]}", "error": "section_order"},
    {"name": "sections overlap", "text": "{\"version\":3,\"sections\":[{\"offset\":{\"line\":0,\"column\":0},\"map\":{\"version\":3,\"sources\":[\"a\"],\"mappings\":\"AAAA,UAAA\"}},{\"offset\":{\"line\":0,\"column\":5},\"map\":{\"version\":3,\"sources\":[],\"mappings\":\"\"}}]}", "error": "section_overlap"},
    {"name": "nested index map", "text": "{\"version\":3,\"sections\":[{\"offset\":{\"line\":0,\"column\":0},\"map\":{\"version\":3,\"sections\":[]}}]}", "error": "nested_index_map"},
    {"name": "section by url refused", "text": "{\"version\":3,\"sections\":[{\"offset\":{\"line\":0,\"column\":0},\"url\":\"https://evil.example/x.map\"}]}", "error": "section_url", "grade": "unsupported"},
    {"name": "section without offset", "text": "{\"version\":3,\"sections\":[{\"map\":{\"version\":3,\"sources\":[],\"mappings\":\"\"}}]}", "error": "invalid_section_offset"},
    {"name": "index map with mappings", "text": "{\"version\":3,\"mappings\":\"\",\"sections\":[]}", "error": "ambiguous_map"},
    {"name": "version 2", "text": "{\"version\":2,\"sources\":[],\"mappings\":\"\"}", "error": "unsupported_version"},
    {"name": "version as string", "text": "{\"version\":\"3\",\"sources\":[],\"mappings\":\"\"}", "error": "unsupported_version"},
    {"name": "missing version", "text": "{\"sources\":[],\"mappings\":\"\"}", "error": "unsupported_version"},
    {"name": "missing mappings", "text": "{\"version\":3,\"sources\":[]}", "error": "missing_mappings"},
    {"name": "missing sources", "text": "{\"version\":3,\"mappings\":\"\"}", "error": "missing_sources"},
    {"name": "names with a number", "text": "{\"version\":3,\"sources\":[],\"names\":[1],\"mappings\":\"\"}", "error": "invalid_field"},
    {"name": "not JSON", "text": "{\"version\":3,", "error": "invalid_json"},
    {"name": "ignoreList out of range", "text": "{\"version\":3,\"sources\":[\"a\"],\"mappings\":\"\",\"ignoreList\":[1]}", "error": "invalid_ignore_list"},
    {"name": "mappings error carries its offset", "text": "{\"version\":3,\"sources\":[\"a\"],\"mappings\":\"AAAA;AACA,AA\"}", "error": "invalid_segment"},
    {"name": "unknown fields ignored", "text": "{\"version\":3,\"sources\":[\"a\"],\"mappings\":\"AAAA\",\"x_custom\":{\"deep\":[1,2]},\"debugId\":\"abc\"}", "grade": "complete", "mapping_count": 1},
    {"name": "unsorted mappings are sorted for lookup", "text": "{\"version\":3,\"sources\":[\"a\"],\"names\":[],\"mappings\":\"UAAA,LAAC\"}", "grade": "complete",
     "lookups": [{"line": 0, "col": 9, "found": true, "source": 0, "orig_line": 0, "orig_col": 1, "name": -1}, {"line": 0, "col": 10, "found": true, "source": 0, "orig_line": 0, "orig_col": 0, "name": -1}, {"line": 0, "col": 4, "found": false}]},
    {"name": "input over the limit", "text": "{\"version\":3,\"sources\":[],\"mappings\":\"\"}", "options": {"max_input_bytes": 10}, "error": "input_too_large", "grade": "partial"},
    {"name": "sources over the limit keep the first ones", "text": "{\"version\":3,\"sources\":[\"a\",\"b\",\"c\"],\"mappings\":\"AAAA,CCAA,CCAA\"}", "options": {"max_sources": 2}, "error": "limit_exceeded", "grade": "partial", "mapping_count": 2, "source_count": 2}
  ]
}
